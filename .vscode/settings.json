{
    "typescript.tsdk": "node_modules/typescript/lib",

    // Formatting is not done in the editor: Prettier runs via `npm run format`,
    // and CI verifies with `prettier --check`. Linting is read-only oxlint run
    // from the terminal (`npm run lint`), with no editor integration.
    "prettier.enable": false,
    "editor.formatOnSave": false
}
