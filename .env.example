# discord
BOT_TOKEN="YOUR_BOT_TOKEN"
TEST_GUILD_ID="YOUR_TEST_GUILD_ID"

# database
# Dev and prod are separate databases that both use the "steammy_bot" schema,
# so only the host and the password differ between environments.
# DATABASE_HOST="database" # if you use docker-compose, it should be the name of the service hosting the database
# DATABASE_PORT=5432
# DATABASE_SSL=true # enable TLS for managed PostgreSQL or pooler connections
# DATABASE_NAME="steammy_bot"
# DATABASE_USER="steammy"
# DATABASE_PASSWORD="steammy123"

# api
# API_PORT=4000

# One-off import of the legacy MikroORM/Supabase data (see
# `npm run db:import-legacy`). Not read by the app and not required in
# production, so it is intentionally absent from src/config/env.schema.ts.
# LEGACY_SUPABASE_CONNECTION_STRING="postgresql://USER:PASSWORD@HOST:5432/postgres"

# The environment is validated at boot with Zod (see src/config/env.schema.ts).
# Required: BOT_TOKEN and every DATABASE_* value above.
