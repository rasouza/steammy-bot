{
  "name": "steammy-bot",
  "version": "2.0.0",
  "description": "Keeps track of your Game platforms' free offers",
  "license": "MIT",
  "main": "build/main.js",
  "scripts": {
    "build": "rimraf build && tsc --project tsconfig.json --skipLibCheck && tsc-alias -p tsconfig.json",
    "start": "cross-env NODE_ENV=production node build/main.js",
    "start:dev": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/main.ts",
    "dev": "cross-env NODE_ENV=development nodemon --watch src --exec ts-node -r tsconfig-paths/register src/main.ts",
    "type:check": "tsc --pretty --skipLibCheck --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "~1.7.9",
    "chalk": "~4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross-env": "~7.0.3",
    "discord-api-types": "~0.37.115",
    "discord.js": "~14.16.3",
    "dotenv": "^16.4.7",
    "filesize": "^10.1.6",
    "necord": "^6.14.0",
    "object-mapper": "^6.2.0",
    "pg": "^8.13.1",
    "reflect-metadata": "~0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.6.4",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "~20.17.9",
    "@types/object-mapper": "^6.2.2",
    "@types/pg": "^8.11.11",
    "eslint": "^9.17.0",
    "nodemon": "^3.1.9",
    "rimraf": "~5.0.10",
    "ts-node": "~10.9.2",
    "tsc-alias": "~1.8.10",
    "tsconfig-paths": "~4.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
