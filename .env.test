# Disposable E2E database: same compose server as development, but its own
# logical database (`steammy_test`) — never the dev one — so the suite can
# wipe its tables freely. Credentials mirror the compose defaults; align them
# here if you override DATABASE_USER / DATABASE_PASSWORD in .env.
# Never use production credentials.
BOT_TOKEN=e2e-dummy-token
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=steammy_test
DATABASE_USER=steammy_dev
DATABASE_PASSWORD=steammy_dev
DATABASE_SSL=false
